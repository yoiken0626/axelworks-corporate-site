# --- 既存: サイト全体で利用 ---
MICROCMS_API_KEY=xxxxxxxxxx
MICROCMS_SERVICE_DOMAIN=xxxxxxxxxx
BASE_URL=xxxxxxxxxx
HUBSPOT_PORTAL_ID=xxxxxxxx
HUBSPOT_FORM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- 追加: 多言語ブログ化プロジェクト フェーズ1（英語自動翻訳パイプライン） ---

# microCMSのPATCH権限のみを付与した書き込み専用APIキー
# title_en / content_en / translation_status の更新にのみ使用する。
# 閲覧用のMICROCMS_API_KEYとは別に発行し、サーバー側の環境変数としてのみ扱うこと。
MICROCMS_MANAGEMENT_API_KEY=xxxxxxxxxx

# Anthropic Claude APIキー（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# 翻訳に使用するモデル（省略時は claude-sonnet-5）
ANTHROPIC_MODEL=claude-sonnet-5

# /api/translate-article 呼び出し時の認証に使う共有シークレット
# microCMSのWebhook設定のカスタムヘッダー x-webhook-secret に同じ値を設定する
TRANSLATE_WEBHOOK_SECRET=xxxxxxxxxx

# --- 追加: トップページの商談予約フォーム（Web3Forms） ---

# Web3Forms のアクセスキー（https://web3forms.com/ でメールアドレスを登録して取得）
# クライアントから直接 api.web3forms.com へ送信するため NEXT_PUBLIC_ プレフィックスが必須。
# Web3Forms のアクセスキーは公開前提の設計（スパムはハニーポット等で防御）。
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
